@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Email Enviado";
}

<div class="d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="col-md-6 col-lg-4 px-3 text-center">

        @* Ícone de Sucesso Visual *@
        <div class="mb-4">
            <div class="display-1 text-orange-gym">
                <i class="bi bi-envelope-check"></i>
            </div>
        </div>

        @* Card de Confirmação *@
        <div class="card shadow-lg border-0 gym-card-style">
            <div class="card-body p-5">
                <h2 class="h4 fw-bold text-uppercase text-white mb-3">Verifica o teu <span class="text-orange-gym">Email</span></h2>

                <p class="text-white-50 mb-4">
                    Enviámos as instruções para a recuperação da tua palavra-passe. Por favor, verifica a tua caixa de entrada (e a pasta de spam).
                </p>

                <div class="d-grid gap-2 border-top border-secondary border-opacity-25 pt-4">
                    <a asp-page="./Login" class="btn btn-gym-orange py-2 fw-bold text-uppercase shadow-sm">
                        Voltar ao Login
                    </a>
                </div>
            </div>
        </div>

        @* Link Extra caso não receba *@
        <p class="mt-4 small text-white-50">
            Não recebeste nada? <a asp-page="./ForgotPassword" class="text-orange-gym text-decoration-none fw-bold">Tentar novamente</a>
        </p>
    </div>
</div>

<style>
    /* Estilos FitMyGoela */
    .gym-card-style {
        background-color: rgba(40, 40, 40, 0.6) !important;
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
    }

    .text-orange-gym { color: #ff6600; }

    .btn-gym-orange {
        background-color: #ff6600;
        color: white !important;
        border: none;
        transition: 0.3s;
    }

    .btn-gym-orange:hover {
        background-color: #e65c00;
        transform: translateY(-1px);
    }

    /* Limpeza de h1 original do Identity */
    h1 { display: none !important; }
</style>