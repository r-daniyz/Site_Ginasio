@page
@model Disable2faModel
@{
    ViewData["Title"] = "Desativar 2FA";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<h3 class="text-orange-gym fw-bold text-uppercase mb-4">@ViewData["Title"]</h3>

<partial name="_StatusMessage" for="StatusMessage" />

@* Alerta de Aviso Estilizado *@
<div class="alert alert-warning border-0 shadow-sm mb-4" style="background-color: rgba(255, 193, 7, 0.1); color: #ffca2c;">
    <div class="d-flex">
        <i class="bi bi-exclamation-triangle-fill me-3 fs-4"></i>
        <div>
            <p class="mb-2"><strong>Esta ação apenas desativa a autenticação de dois fatores.</strong></p>
            <p class="small mb-0 opacity-75">
                Desativar o 2FA não altera as chaves nas apps de autenticação. Se quiseres mudar a chave, deves
                <a asp-page="./ResetAuthenticator" class="text-warning fw-bold text-decoration-none border-bottom border-warning">redefinir as tuas chaves de autenticação.</a>
            </p>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <form method="post">
            <div class="card bg-dark bg-opacity-25 border border-secondary border-opacity-25 p-4 mb-4 text-center">
                <p class="text-white-50 small mb-4">
                    Ao desativar o 2FA, a segurança da tua conta será reduzida. Terás de usar apenas a tua palavra-passe para entrar.
                </p>
                <button class="btn btn-danger py-2 px-4 fw-bold text-uppercase shadow-sm w-100" type="submit">
                    Desativar Autenticação 2FA
                </button>
            </div>

            <a asp-page="./TwoFactorAuthentication" class="btn btn-link text-secondary text-decoration-none btn-sm text-uppercase fw-bold d-block text-center">
                Voltar às definições de segurança
            </a>
        </form>
    </div>
</div>

<style>
    .text-orange-gym { color: #ff6600; }

    .btn-danger {
        background-color: #dc3545;
        border: none;
        transition: 0.3s;
    }

    .btn-danger:hover {
        background-color: #bb2d3b;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3);
    }

    .alert a:hover {
        color: #fff !important;
        border-color: #fff !important;
    }
</style>