@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Alterar Palavra-passe";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3 class="text-orange-gym fw-bold text-uppercase mb-4">@ViewData["Title"]</h3>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-md-8 col-lg-6">
        <form id="change-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            @* Password Atual *@
            <div class="form-group mb-3">
                <label asp-for="Input.OldPassword" class="fw-bold text-white-50 small text-uppercase mb-1">Palavra-passe Atual</label>
                <input asp-for="Input.OldPassword" class="form-control gym-input" autocomplete="current-password" aria-required="true" placeholder="Introduza a password atual" />
                <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
            </div>

            @* Nova Password *@
            <div class="form-group mb-3">
                <label asp-for="Input.NewPassword" class="fw-bold text-white-50 small text-uppercase mb-1">Nova Palavra-passe</label>
                <input asp-for="Input.NewPassword" class="form-control gym-input" autocomplete="new-password" aria-required="true" placeholder="Mínimo 6 caracteres" />
                <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
            </div>

            @* Confirmar Nova Password *@
            <div class="form-group mb-4">
                <label asp-for="Input.ConfirmPassword" class="fw-bold text-white-50 small text-uppercase mb-1">Confirmar Nova Palavra-passe</label>
                <input asp-for="Input.ConfirmPassword" class="form-control gym-input" autocomplete="new-password" aria-required="true" placeholder="Repita a nova password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="w-100 btn btn-gym-orange py-2 fw-bold text-uppercase shadow-sm">
                Atualizar Password
            </button>
        </form>
    </div>
</div>

<style>
    /* Estilos locais para manter a consistência com o tema Dark/Orange */
    .text-orange-gym {
        color: #ff6600;
    }

    .gym-input {
        background-color: rgba(0, 0, 0, 0.3) !important;
        border: 1px solid #444 !important;
        color: white !important;
        padding: 0.6rem 1rem;
    }

        .gym-input:focus {
            border-color: #ff6600 !important;
            box-shadow: none !important;
            background-color: rgba(0, 0, 0, 0.5) !important;
        }

    .btn-gym-orange {
        background-color: #ff6600;
        color: white !important;
        border: none;
        transition: 0.3s;
    }

        .btn-gym-orange:hover {
            background-color: #e65c00;
            transform: translateY(-1px);
        }

    /* Removemos o floating label original que causa problemas visual no tema dark */
    .form-floating > label {
        display: none;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}