@model IEnumerable<FitMyGoela.Models.TiposDeTreino>

@{
    ViewData["Title"] = "Categorias de Treino";
}

@* Importar Ícones do Bootstrap *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
        :root {
                --gym-orange: #ff6600;
                --gym-dark: #1a1a1a;
                --gym-card: #212529;

    }

        .table-gym {
                color: white !important;

    }

        .text-category-name {
                color: #ffffff !important;
                font-weight: bold;

    }

        .btn-gym-orange {
                background-color: var(--gym-orange);
                border-color: var(--gym-orange);
                color: white !important;
                font-weight: bold;

    }

            .btn-gym-orange:hover {
                    background-color: #e65c00;
                    color: white !important;

    }

        .bg-gym-dark {
                background-color: var(--gym-dark) !important;
                color: white;

    }

        .card {
                background-color: var(--gym-card) !important;
                border: 1px solid #333 !important;

    }

        .table-gym thead {
                background-color: #111 !important;
                color: var(--gym-orange) !important;

    }
</style>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-uppercase" style="color: white; border-left: 5px solid var(--gym-orange); padding-left: 15px;">
            Tipos de Treino
        </h2>
        <a asp-action="Create" class="btn btn-gym-orange shadow-sm text-uppercase">
            <i class="bi bi-plus-lg"></i> Novo Treino
        </a>
    </div>

    @* --- BLOCO DE AVISO (ADICIONADO) --- *@
    @if (TempData["ErroDelete"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show bg-dark text-warning border-warning mb-4 shadow-lg" role="alert" style="border-left: 5px solid #ffc107;">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                <div>
                    <h6 class="mb-0 fw-bold text-uppercase">Operação Impedida</h6>
                    <small>@TempData["ErroDelete"]</small>
                </div>
            </div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @* ---------------------------------- *@

    @* Seção de Pesquisa *@
    <div class="card bg-gym-dark shadow-sm mb-4">
        @* ... (conteúdo da pesquisa) ... *@
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-9">
                    <label class="form-label text-light small fw-bold">Pesquisar Treino</label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-secondary text-white"><i class="bi bi-search"></i></span>
                        <input type="text" name="pesquisa" value="@Context.Request.Query["pesquisa"]"
                               class="form-control bg-dark text-white border-secondary" placeholder="Ex: Hipertrofia, Cardio, Crossfit..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-gym-orange w-100 text-uppercase">
                        Filtrar
                    </button>
                </div>
            </form>
        </div>
    </div>

    @* Tabela de Tipos de Treino *@
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle table-gym">
                    <thead>
                        <tr>
                            <th class="ps-4">@Html.DisplayNameFor(model => model.Nome)</th>
                            <th>@Html.DisplayNameFor(model => model.Descricao)</th>
                            <th class="text-center">Duração</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr style="border-bottom: 1px solid #333;">
                                    <td class="ps-4">
                                        <div class="text-category-name">@item.Nome</div>
                                    </td>
                                    <td>
                                        <small class="text-secondary d-block text-truncate" style="max-width: 400px;">
                                            @(string.IsNullOrEmpty(item.Descricao) ? "Sem descrição" : item.Descricao)
                                        </small>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-dark border border-secondary p-2">
                                            <i class="bi bi-clock me-1" style="color: #ff6600;"></i> @item.DuracaoMinutos min
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                                                       class="btn btn-secondary border-0"
                                                                       style="background-color: #444 !important;" title="Editar">
                                                <i class="bi bi-pencil-fill text-white"></i>
                                            </a>

                                            <a asp-action="Details" asp-route-id="@item.Id"
                                                                       class="btn btn-dark border-0"
                                                                       style="background-color: #2c2c2c !important;" title="Detalhes">
                                                <i class="bi bi-eye-fill text-white"></i>
                                            </a>

                                            <a asp-action="Delete" asp-route-id="@item.Id"
                                                                       class="btn btn-danger border-0"
                                                                       style="background-color: #8b0000 !important;" title="Apagar">
                                                <i class="bi bi-trash3-fill text-white"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <i class="bi bi-folder-x d-block fs-2 mb-2"></i>
                                    Nenhuma categoria encontrada.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>