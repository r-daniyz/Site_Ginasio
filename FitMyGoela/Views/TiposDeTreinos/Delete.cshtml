@model FitMyGoela.Models.TiposDeTreino

@{
    ViewData["Title"] = "Eliminar Treino";
}

<div class="main-center-wrapper">
    <div class="col-md-6 col-lg-4 px-3">
        
        @* Título de Aviso *@
        <div class="text-center mb-4">
            <h1 class="display-6 fw-bold text-uppercase" style="color: #dc3545; letter-spacing: 2px;">
                Eliminar <span class="text-white">Treino?</span>
            </h1>
            <p class="text-white-50 small mt-2">Esta ação não pode ser desfeita.</p>
        </div>

        @* Card de Confirmação *@
        <div class="card shadow-lg border-0 gym-card-style border-danger-subtle">
            <div class="card-header border-danger border-opacity-25 bg-dark py-3 text-center">
                <small class="text-danger text-uppercase fw-bold" style="letter-spacing: 1px;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Confirmar Exclusão
                </small>
            </div>
            
            <div class="card-body p-4">
                @* Dados do que vai ser apagado *@
                <div class="mb-3">
                    <label class="fw-bold text-orange-gym small text-uppercase mb-1 d-block">Treino</label>
                    <p class="text-white mb-0 ps-2">@Html.DisplayFor(model => model.Nome)</p>
                </div>

                <div class="mb-4">
                    <label class="fw-bold text-orange-gym small text-uppercase mb-1 d-block">Duração</label>
                    <p class="text-white-50 mb-0 ps-2 small">@Html.DisplayFor(model => model.DuracaoMinutos) minutos</p>
                </div>

                @* Formulário de Eliminação *@
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger py-2 fw-bold text-uppercase shadow-sm">
                            <i class="bi bi-trash3 me-2"></i> Eliminar Definitivamente
                        </button>
                        
                        <a asp-action="Index" class="btn btn-link text-secondary text-decoration-none btn-sm text-uppercase fw-bold mt-1">
                            Não, voltar atrás
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
   
    .main-center-wrapper {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 999;
    }

   
    .gym-card-style {
        background-color: rgba(45, 20, 20, 0.4) !important;
        backdrop-filter: blur(8px);
        border: 1px solid rgba(220, 53, 69, 0.2) !important;
    }

    .text-orange-gym { color: #ff6600; }

    .btn-danger {
        background-color: #dc3545;
        border: none;
        transition: all 0.2s;
    }

    .btn-danger:hover {
        background-color: #bb2d3b;
        transform: scale(1.02);
    }


    h1:not(.display-6), h3, hr, dt, dd, h4 { display: none !important; }
    .main-center-wrapper h1, .main-center-wrapper p { display: block !important; }
</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">