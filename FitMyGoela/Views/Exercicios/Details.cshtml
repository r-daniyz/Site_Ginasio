@model FitMyGoela.Models.Exercicio

@{
    ViewData["Title"] = "Detalhes do Exercício";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-9">
            @* Título Superior *@
            <h2 class="text-center mb-4" style="color: #ff6600; font-weight: bold; text-transform: uppercase;">
                Visualizar Exercício
            </h2>

            <div class="card shadow-lg border-0" style="background-color: #1a1a1a;">
                @* Cabeçalho do Card *@
                <div class="card-header bg-dark border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                    <span class="text-white fw-bold"><i class="bi bi-info-circle me-2"></i> Informações Técnicas</span>
                    <span class="badge bg-secondary px-3">Modo Visualização</span>
                </div>

                <div class="card-body p-4 text-white">
                    <div class="row">
                        @* Coluna da Esquerda: Dados *@
                        <div class="col-md-7 border-end border-secondary border-opacity-25">
                            <div class="mb-4">
                                <label class="text-orange-gym small text-uppercase fw-bold d-block">Nome do Exercício</label>
                                <span class="fs-5">@Model.Nome</span>
                            </div>

                            <div class="mb-4">
                                <label class="text-orange-gym small text-uppercase fw-bold d-block">Descrição / Técnica</label>
                                <p class="text-white-50">@(string.IsNullOrEmpty(Model.Descricao) ? "Sem descrição disponível." : Model.Descricao)</p>
                            </div>

                            <div class="row mb-4">
                                <div class="col-6">
                                    <label class="text-orange-gym small text-uppercase fw-bold d-block">Séries</label>
                                    <span class="badge bg-dark border border-secondary px-3 py-2">@Model.Series</span>
                                </div>
                                <div class="col-6">
                                    <label class="text-orange-gym small text-uppercase fw-bold d-block">Repetições</label>
                                    <span class="badge bg-dark border border-secondary px-3 py-2">@Model.Repeticoes</span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="text-orange-gym small text-uppercase fw-bold d-block">Link do Tutorial</label>
                                @if (!string.IsNullOrEmpty(Model.LinkVideoTutorial))
                                {
                                    <a href="@Model.LinkVideoTutorial" target="_blank" class="text-info text-decoration-none small">
                                        <i class="bi bi-play-circle me-1"></i> Assistir Vídeo no YouTube
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small italic">Nenhum link disponível</span>
                                }
                            </div>
                        </div>

                        @* Coluna da Direita: Imagem *@
                        <div class="col-md-5 text-center d-flex flex-column align-items-center justify-content-center bg-dark bg-opacity-25 rounded p-3">
                            <label class="text-orange-gym small text-uppercase fw-bold mb-3">Imagem de Referência</label>

                            <div class="mb-3" style="width: 100%; max-width: 250px; height: 180px; background-color: #111; border-radius: 8px; border: 2px solid #333; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                                @if (!string.IsNullOrEmpty(Model.Imagem))
                                {
                                    <img src="~/imagens/@Model.Imagem" style="width: 100%; height: 100%; object-fit: cover;" alt="@Model.Nome" />
                                }
                                else
                                {
                                    <div class="text-secondary d-flex flex-column align-items-center">
                                        <i class="bi bi-camera-video-off" style="font-size: 2.5rem;"></i>
                                        <span class="small mt-2">Sem Foto</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <hr class="border-secondary border-opacity-25 my-4" />

                    @* Botões de Ação *@
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-light btn-sm px-4 text-uppercase fw-bold">
                            <i class="bi bi-arrow-left"></i> Voltar
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-gym-orange text-white btn-sm px-4 text-uppercase fw-bold">
                            <i class="bi bi-pencil-square"></i> Editar Exercício
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .text-orange-gym { color: #ff6600; }
    .btn-gym-orange { background-color: #ff6600; border: none; }
    .btn-gym-orange:hover { background-color: #cc5200; color: white; }
</style>