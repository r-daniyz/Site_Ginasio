@model FitMyGoela.Models.Exercicio

@{
    ViewData["Title"] = "Editar Exercício";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-9">
            @* Título Superior *@
            <h2 class="text-center mb-4" style="color: #ff6600; font-weight: bold; text-transform: uppercase;">
                Editar: @Model.Nome
            </h2>

            <div class="card shadow-lg border-0" style="background-color: #1a1a1a;">
                @* Cabeçalho do Card *@
                <div class="card-header bg-dark border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                    <span class="text-white fw-bold"><i class="bi bi-pencil-square me-2"></i> Alterar Detalhes</span>
                    <span class="badge bg-primary px-3">Modo Edição</span>
                </div>

                <div class="card-body p-4 text-white">
      
                    <form asp-action="Edit" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        @* ID Escondido para o Controller saber qual exercício editar *@
                        <input type="hidden" asp-for="Id" />

                        @* Chama a mesma Partial View dos campos *@
                        <partial name="_FormExercicio" model="Model" />

                        <hr class="border-secondary border-opacity-25 my-4" />

                        @* Botões de Ação *@
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-light btn-sm px-4">
                                <i class="bi bi-arrow-left"></i> Voltar
                            </a>
                            <button type="submit" class="btn btn-gym-orange text-white fw-bold px-4 shadow-sm">
                                <i class="bi bi-save me-1"></i> GUARDAR ALTERAÇÕES
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}