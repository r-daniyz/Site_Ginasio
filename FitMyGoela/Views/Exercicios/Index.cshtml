@model FitMyGoela.ViewModels.ExercicioFiltroViewModel

@{
    ViewData["Title"] = "Exercícios";
}

@* Importar Ícones do Bootstrap *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        --gym-orange: #ff6600;
        --gym-dark: #1a1a1a;
        --gym-card: #212529;
    }

    .table-gym {
        color: white !important;
    }

    .text-exercise-name {
        color: #ffffff !important;
        font-weight: bold;
    }

    .btn-gym-orange {
        background-color: var(--gym-orange);
        border-color: var(--gym-orange);
        color: white !important;
        font-weight: bold;
    }

        .btn-gym-orange:hover {
            background-color: #e65c00;
            color: white !important;
        }

    .bg-gym-dark {
        background-color: var(--gym-dark) !important;
        color: white;
    }

    .card {
        background-color: var(--gym-card) !important;
        border: 1px solid #333 !important;
    }

    .table-gym thead {
        background-color: #111 !important;
        color: var(--gym-orange) !important;
    }

    .badge-orange {
        background-color: var(--gym-orange);
        color: white;
    }
</style>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-uppercase" style="color: white; border-left: 5px solid var(--gym-orange); padding-left: 15px;">
            Exercícios
        </h2>
        <a asp-action="Create" class="btn btn-gym-orange shadow-sm text-uppercase">
            <i class="bi bi-plus-lg"></i> Novo Exercício
        </a>
    </div>

    @* Seção de Filtros *@
    <div class="card bg-gym-dark shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label text-light small fw-bold">Pesquisar</label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-secondary text-white"><i class="bi bi-search"></i></span>
                        <input type="text" name="pesquisa" value="@Model.Pesquisa"
                               class="form-control bg-dark text-white border-secondary" placeholder="Ex: Supino, Agachamento..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label text-light small fw-bold">Tipo de Treino</label>
                    <select name="tiposdetreinoId" class="form-select bg-dark text-white border-secondary">
                        <option value="">Todos os Treinos</option>
                        @if (Model.TiposDeTreinos != null)
                        {
                            @foreach (var cat in Model.TiposDeTreinos)
                            {
                                <option value="@cat.Id" selected="@(cat.Id == Model.TiposDeTreinoId)">
                                    @cat.Nome
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-gym-orange w-100 text-uppercase">
                        Filtrar
                    </button>
                </div>
            </form>
        </div>
    </div>

    @* Tabela de Exercícios *@
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle table-gym">
                    <thead>
                        <tr>
                            <th class="ps-4">Foto</th>
                            <th>Exercício</th>
                            <th>Séries / Reps</th>
                            <th>Treinos</th>
                            <th>Tutorial</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Exercicios != null && Model.Exercicios.Any())
                        {
                            @foreach (var item in Model.Exercicios)
                            {
                                <tr style="border-bottom: 1px solid #333;">
                                    <td class="ps-4">
                                        @if (!string.IsNullOrEmpty(item.Imagem))
                                        {
                                            <img src="~/imagens/@item.Imagem" width="60" height="60"
                                                 class="rounded-3 shadow-sm" style="object-fit: cover; border: 2px solid var(--gym-orange);" />
                                        }
                                        else
                                        {
                                            <div class="bg-dark d-flex align-items-center justify-content-center rounded-3"
                                                 style="width: 60px; height: 60px; border: 1px dashed #444;">
                                                <i class="bi bi-camera text-muted"></i>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <div class="text-exercise-name">@item.Nome</div>
                                        <small class="text-secondary d-block text-truncate" style="max-width: 200px;">@item.Descricao</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-dark border border-secondary">@item.Series x @item.Repeticoes</span>
                                    </td>
                                    <td>
                                        <span class="badge badge-orange">@item.TiposDeTreino?.Nome</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.LinkVideoTutorial))
                                        {
                                            <a href="@item.LinkVideoTutorial" target="_blank" class="btn btn-sm btn-outline-danger border-0">
                                                <i class="bi bi-youtube fs-4"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">---</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            @* Editar *@
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-secondary border-0"
                                               style="background-color: #444 !important;" title="Editar">
                                                <i class="bi bi-pencil-fill text-white"></i>
                                            </a>

                                            @* Detalhes *@
                                            <a asp-action="Details" asp-route-id="@item.Id"
                                               class="btn btn-dark border-0"
                                               style="background-color: #2c2c2c !important;" title="Detalhes">
                                                <i class="bi bi-eye-fill text-white"></i>
                                            </a>

                                            @* Apagar  *@
                                            <a asp-action="Delete" asp-route-id="@item.Id"
                                               class="btn btn-danger border-0"
                                               style="background-color: #8b0000 !important;" title="Apagar">
                                                <i class="bi bi-trash3-fill text-white"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-info-circle d-block fs-2 mb-2"></i>
                                    Nenhum exercício encontrado.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* Paginação *@
    <div class="d-flex justify-content-center mt-4 pb-4">
        <nav aria-label="Navegação">
            <ul class="pagination">
                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    <li class="page-item @(i == Model.PaginaAtual ? "active" : "")">
                        <a class="page-link bg-dark border-secondary text-white shadow-sm mx-1 rounded"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-pesquisa="@Model.Pesquisa"
                           asp-route-tiposdetreinoId="@Model.TiposDeTreinoId">
                            @i
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>